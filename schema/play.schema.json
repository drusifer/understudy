{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudy.local/schema/play.schema.json",
  "title": "A play",
  "description": "The shape of a play file: a stage (its props and the files it reads and writes) and a scene of beats. Names, references, conditions and weights are checked further by understudy check.",
  "type": "object",
  "required": ["name", "scene"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "stage": {
      "description": "The play's interface: every prop it takes and every file it reads or writes.",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/piece" }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          },
          { "$ref": "#/$defs/candidates" }
        ]
      }
    },
    "data": { "type": "object" },
    "scene": { "$ref": "#/$defs/scene" }
  },
  "$defs": {
    "piece": {
      "description": "A prop (a typed value: choice, range, count or switch) or a file the play reads (the default) or writes.",
      "type": "object",
      "required": ["kind"],
      "if": { "properties": { "kind": { "const": "file" } } },
      "then": {
        "required": ["kind", "path"],
        "additionalProperties": false,
        "properties": {
          "kind": { "const": "file" },
          "path": { "type": "string", "minLength": 1 },
          "optional": { "type": "string", "minLength": 1 },
          "access": { "enum": ["read", "write"] }
        }
      },
      "else": {
        "properties": { "kind": { "enum": ["choice", "range", "count", "switch"] } }
      }
    },
    "doRef": {
      "description": "What a beat does: a type as the key, which one as the value.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "map": { "$ref": "#/$defs/action" },
        "reduce": { "$ref": "#/$defs/action" },
        "write": { "type": "string", "minLength": 1 },
        "play": { "type": "string", "pattern": "^[^/]+\\.yaml$" },
        "jev": {
          "type": "object",
          "required": ["question"],
          "additionalProperties": false,
          "properties": { "question": { "const": "choice" } }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": { "action": { "type": "string", "minLength": 1 } }
    },
    "candidates": {
      "description": "Options that exist only in data: the values of `key` in the rows of a piece (or a beat's result).",
      "type": "object",
      "required": ["from", "key"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "jevWith": {
      "description": "The `with:` of a Jev beat: what Jev is told, what it chooses from, and what it is shown.",
      "type": "object",
      "required": ["instructions", "state"],
      "oneOf": [{ "required": ["criteria"] }, { "required": ["options"] }],
      "additionalProperties": false,
      "properties": {
        "instructions": { "type": "string", "minLength": 1 },
        "options": { "$ref": "#/$defs/candidates" },
        "criteria": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "state": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["from"],
            "additionalProperties": false,
            "properties": { "from": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "weight": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        {
          "type": "object",
          "required": ["if", "then"],
          "additionalProperties": false,
          "properties": {
            "if": { "type": "object" },
            "then": { "$ref": "#/$defs/weight" },
            "else": { "$ref": "#/$defs/weight" }
          }
        }
      ]
    },
    "blendEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decide": { "type": "object" },
        "from": { "type": "string", "minLength": 1 },
        "weight": { "$ref": "#/$defs/weight" }
      },
      "oneOf": [{ "required": ["decide"] }, { "required": ["from"] }]
    },
    "forbid": {
      "type": "object",
      "required": ["when", "drop"],
      "additionalProperties": false,
      "properties": {
        "when": { "type": "object" },
        "drop": { "type": "object" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "if": { "type": "object" },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "beat": {
      "description": "One step: do an action with props. With `to:` or `transitions:` (or `final`) it is in the scene's flow; without, it is performed when another beat first reads it.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "do": { "$ref": "#/$defs/doRef" },
        "each": { "type": "string", "minLength": 1 },
        "reduce": {
          "description": "With `each`: fold the iterations. Each iteration's rows are merged into a running list that the next iteration receives as the variable `into`.",
          "type": "object",
          "required": ["action", "into"],
          "additionalProperties": false,
          "properties": {
            "action": { "const": "concat" },
            "into": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          }
        },
        "with": { "type": "object" },
        "to": { "type": "string", "minLength": 1 },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" }, "minItems": 1 },
        "final": { "type": "boolean" },
        "outcome": { "type": "string" },
        "outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["do"], "properties": { "do": { "required": ["reduce"], "properties": { "reduce": {
            "required": ["action"], "properties": { "action": { "const": "blend" } } } } } } },
          "then": { "required": ["with"], "properties": { "with": { "$ref": "#/$defs/blendWith" } } }
        },
        {
          "if": { "required": ["do"], "properties": { "do": { "required": ["jev"] } } },
          "then": { "required": ["with"], "properties": { "with": { "$ref": "#/$defs/jevWith" } } }
        }
      ]
    },
    "blendWith": {
      "description": "The `with:` of `reduce: { action: blend }`: the weighted entries to combine, and the rules around them.",
      "type": "object",
      "required": ["entries"],
      "additionalProperties": false,
      "properties": {
        "entries": { "type": "array", "items": { "$ref": "#/$defs/blendEntry" }, "minItems": 1 },
        "forbid": { "type": "array", "items": { "$ref": "#/$defs/forbid" } },
        "on_empty": { "enum": ["fail", "fallback", "skip"] },
        "shortlist": { "type": "integer", "minimum": 1 }
      }
    },
    "scene": {
      "type": "object",
      "required": ["initial", "beats"],
      "additionalProperties": false,
      "properties": {
        "initial": { "type": "string", "minLength": 1 },
        "beats": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/beat" }
        }
      }
    }
  }
}
