{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://understudy.local/schema/decision_sketch.schema.json",
  "title": "A decision sketch",
  "description": "The shape of a sketch file. Names, references, conditions and weights are checked further by understudy check.",
  "type": "object",
  "required": ["name", "machine"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "sources": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "sinks": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sink" }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "minItems": 1,
        "uniqueItems": true
      }
    },
    "data": { "type": "object" },
    "machine": { "$ref": "#/$defs/machine" }
  },
  "$defs": {
    "source": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["kind", "path"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "file" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "question", "instructions", "criteria", "state"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "jev" },
            "question": { "const": "choice" },
            "instructions": { "type": "string", "minLength": 1 },
            "criteria": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "state": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["from"],
                "additionalProperties": false,
                "properties": { "from": { "type": "string", "minLength": 1 } }
              }
            }
          }
        }
      ]
    },
    "sink": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["kind", "path"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "file" },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "weight": {
      "oneOf": [
        { "type": "number", "minimum": 0 },
        {
          "type": "object",
          "required": ["if", "then"],
          "additionalProperties": false,
          "properties": {
            "if": { "type": "object" },
            "then": { "$ref": "#/$defs/weight" },
            "else": { "$ref": "#/$defs/weight" }
          }
        }
      ]
    },
    "blendEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decide": { "type": "object" },
        "decider": { "type": "string", "minLength": 1 },
        "weight": { "$ref": "#/$defs/weight" }
      },
      "oneOf": [{ "required": ["decide"] }, { "required": ["decider"] }]
    },
    "forbid": {
      "type": "object",
      "required": ["when", "drop"],
      "additionalProperties": false,
      "properties": {
        "when": { "type": "object" },
        "drop": { "type": "object" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["to"],
      "additionalProperties": false,
      "properties": {
        "if": { "type": "object" },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "do": { "type": "string", "minLength": 1 },
        "with": { "type": "object" },
        "blend": { "type": "array", "items": { "$ref": "#/$defs/blendEntry" }, "minItems": 1 },
        "forbid": { "type": "array", "items": { "$ref": "#/$defs/forbid" } },
        "on_empty": { "enum": ["fail", "fallback", "skip"] },
        "then": { "type": "string", "minLength": 1 },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" }, "minItems": 1 },
        "final": { "type": "boolean" },
        "outcome": { "type": "string" },
        "returns": {
          "type": "object",
          "required": ["decider"],
          "additionalProperties": false,
          "properties": {
            "decider": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        }
      }
    },
    "machine": {
      "type": "object",
      "required": ["initial", "states"],
      "additionalProperties": false,
      "properties": {
        "initial": { "type": "string", "minLength": 1 },
        "states": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/state" }
        }
      }
    }
  }
}
