{
  "name": "understudy",
  "version": "0.1.0",
  "description": "Stand-in players for apps under test: Jev-driven actors that play web and CLI/HTTP targets.",
  "type": "module",
  "license": "GPL-3.0-only",
  "bin": {
    "understudy": "bin/understudy.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:js": "node --test tests/*.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.js",
    "lint": "eslint --no-error-on-unmatched-pattern 'src/**/*.mjs' 'bin/**/*.mjs' 'examples/**/*.mjs' 'examples/**/*.js' 'tests/**/*.js' 'tests/**/*.mjs'"
  },
  "dependencies": {
    "@fontsource/antonio": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.1",
    "@fontsource/spectral": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "elkjs": "^0.12.0",
    "lru-cache": "^11.5.3",
    "playwright": "^1.62.1",
    "xstate": "^5.33.2",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^73.0.0"
  }
}
